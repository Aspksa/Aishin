# Aishin AI provider
AISHIN_AI_PROVIDER=cloudru

# Cloud.ru Evolution Foundation Models
AISHIN_CLOUDRU_URL=https://foundation-models.api.cloud.ru/v1

# Create the key in Cloud.ru and keep the secret only in your local .env.
# Never commit a real API key to GitHub.
AISHIN_CLOUDRU_API_KEY=

# Default example from Cloud.ru documentation. You can replace it later.
AISHIN_CLOUDRU_MODEL=ai-sage/GigaChat3-10B-A1.8B

# Seconds
AISHIN_CLOUDRU_TIMEOUT=120
